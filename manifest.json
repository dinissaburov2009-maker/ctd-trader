{
  "name": "CTD Trader",
  "short_name": "CTD",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#04070b",
  "theme_color": "#04070b",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shots",
          "accept": ["image/*"]
        }
      ]
    }
  }
}